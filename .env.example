# Copia estas variables en Vercel (Project Settings -> Environment Variables).
# Nunca subas un .env real con valores de verdad a git.

# Cal.com (Settings -> Developer -> API keys, en la cuenta de Lamberto)
CALCOM_API_KEY=cal_live_xxxxxxxx

# Stripe (Dashboard -> Developers -> API keys, en la cuenta de Lamberto)
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Se genera al crear el endpoint del webhook (Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
